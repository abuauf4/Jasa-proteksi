# Production database connection
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Generate a new long random secret for production.
NEXTAUTH_SECRET=replace-with-a-new-random-secret
NEXTAUTH_URL=https://jasaproteksi.com

# Canonical public URL used by metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://jasaproteksi.com
